# Explicit Release payload; never package the build directory wholesale.
install(TARGETS warblade RUNTIME DESTINATION . CONFIGURATIONS Release)
install(FILES $<TARGET_RUNTIME_DLLS:warblade> DESTINATION . CONFIGURATIONS Release)
install(FILES "${PROJECT_SOURCE_DIR}/LICENSE" DESTINATION licenses
        RENAME warblade.txt CONFIGURATIONS Release)
install(DIRECTORY "${PROJECT_SOURCE_DIR}/assets/" DESTINATION assets
        CONFIGURATIONS Release)
foreach(dependency IN ITEMS sdl3 sdl3-image sdl3-mixer libxmp zlib libpng libjpeg-turbo libspng)
    install(FILES "${VCPKG_INSTALLED_DIR}/${VCPKG_TARGET_TRIPLET}/share/${dependency}/copyright"
            DESTINATION "licenses/third-party/${dependency}" RENAME copyright.txt
            CONFIGURATIONS Release)
endforeach()
# Run last, after the payload is staged. An install-script failure stops CPack
# before it can compile an installer; do not use a best-effort pre-build hook.
install(SCRIPT "${PROJECT_SOURCE_DIR}/cmake/SignPayload.cmake" CONFIGURATIONS Release)

set(CPACK_GENERATOR INNOSETUP)
set(CPACK_PACKAGE_NAME Warblade)
set(CPACK_PACKAGE_VENDOR kha1ne)
set(CPACK_PACKAGE_DESCRIPTION_SUMMARY "Warblade")
set(CPACK_PACKAGE_VERSION "${PROJECT_VERSION}")
set(CPACK_PACKAGE_FILE_NAME "Warblade-${PROJECT_VERSION}-windows-x64-setup")
set(CPACK_PACKAGE_DIRECTORY "${PROJECT_SOURCE_DIR}/dist")
set(CPACK_PACKAGE_INSTALL_DIRECTORY Warblade)
set(CPACK_PACKAGE_HOMEPAGE_URL "https://github.com/kha1ne/warblade")
set(CPACK_PACKAGE_EXECUTABLES warblade Warblade)
set(CPACK_CREATE_DESKTOP_LINKS warblade)
set(CPACK_RESOURCE_FILE_LICENSE "${PROJECT_SOURCE_DIR}/LICENSE")
set(CPACK_VERBATIM_VARIABLES ON)
set(CPACK_INNOSETUP_EXECUTABLE "${PROJECT_SOURCE_DIR}/.tools/innosetup-7.1.0/ISCC.exe")
set(CPACK_INNOSETUP_ICON_FILE "${WARBLADE_ICON_FILE}")
set(CPACK_INNOSETUP_ARCHITECTURE x64)
set(CPACK_INNOSETUP_INSTALL_ROOT "{localappdata}/Programs")
set(CPACK_INNOSETUP_PROGRAM_MENU_FOLDER Warblade)
set(CPACK_INNOSETUP_USE_MODERN_WIZARD ON)
set(CPACK_INNOSETUP_IGNORE_README_PAGE ON)
set(CPACK_INNOSETUP_CREATE_UNINSTALL_LINK ON)
# Stable across releases: upgrading reuses the existing installation.
set(CPACK_INNOSETUP_SETUP_AppId "io.github.kha1ne.warblade")
set(CPACK_INNOSETUP_SETUP_AppPublisherURL "${CPACK_PACKAGE_HOMEPAGE_URL}")
set(CPACK_INNOSETUP_SETUP_PrivilegesRequired lowest)
set(CPACK_INNOSETUP_SETUP_MinVersion "10.0")
set(CPACK_INNOSETUP_SETUP_ArchitecturesAllowed x64compatible)
set(CPACK_INNOSETUP_SETUP_ArchitecturesInstallIn64BitMode x64compatible)
set(CPACK_INNOSETUP_SETUP_SetupArchitecture x64)
set(CPACK_INNOSETUP_SETUP_UninstallDisplayIcon "{app}/warblade.exe")
set(CPACK_INNOSETUP_SETUP_Compression "lzma2/normal")
set(CPACK_INNOSETUP_SETUP_SolidCompression ON)
set(CPACK_PROJECT_CONFIG_FILE "${PROJECT_SOURCE_DIR}/cmake/CPackProjectConfig.cmake")
include(CPack)
