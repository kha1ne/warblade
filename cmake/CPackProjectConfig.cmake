if(NOT CPACK_GENERATOR STREQUAL "INNOSETUP" OR NOT CPACK_BUILD_CONFIG STREQUAL "Release")
    message(FATAL_ERROR "Only Release Inno Setup packaging is supported. Use build.bat release package.")
endif()
if(NOT EXISTS "${CPACK_INNOSETUP_EXECUTABLE}")
    message(FATAL_ERROR "Inno Setup is missing. Run setup.ps1 using the command in README.md.")
endif()

include("${CMAKE_CURRENT_LIST_DIR}/Signing.cmake")
warblade_sign_command(sign_command)
if(sign_command)
    set(sign_command_string "")
    foreach(argument IN LISTS sign_command)
        string(APPEND sign_command_string "$q${argument}$q ")
    endforeach()
    set(CPACK_POST_BUILD_SCRIPTS "${CMAKE_CURRENT_LIST_DIR}/VerifyPackage.cmake")
    set(CPACK_INNOSETUP_SETUP_SignTool "warblade-sign")
    set(CPACK_INNOSETUP_SETUP_SignedUninstaller ON)
    list(APPEND CPACK_INNOSETUP_EXECUTABLE_ARGUMENTS
         "\"/Swarblade-sign=${sign_command_string}$f\"")
else()
    set(CPACK_INNOSETUP_SETUP_SignedUninstaller OFF)
    message(STATUS "Creating an unsigned development installer (no signing identity configured).")
endif()
