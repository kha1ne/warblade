{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build: Debug",
      "type": "process",
      "command": "cmd.exe",
      "args": ["/d", "/c", "build.bat", "debug"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": "$msCompile",
      "group": { "kind": "build", "isDefault": true }
    },
    {
      "label": "Build: Release",
      "type": "process",
      "command": "cmd.exe",
      "args": ["/d", "/c", "build.bat", "release"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": "$msCompile",
      "group": "build"
    },
    {
      "label": "Build: ASan",
      "type": "process",
      "command": "cmd.exe",
      "args": ["/d", "/c", "build.bat", "asan"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": "$msCompile",
      "group": "build"
    },
    {
      "label": "Run: Debug",
      "type": "process",
      "command": "${workspaceFolder}/build/debug/warblade.exe",
      "options": { "cwd": "${workspaceFolder}/build/debug" },
      "dependsOn": "Build: Debug",
      "problemMatcher": []
    },
    {
      "label": "Run: Release",
      "type": "process",
      "command": "${workspaceFolder}/build/release/warblade.exe",
      "options": { "cwd": "${workspaceFolder}/build/release" },
      "dependsOn": "Build: Release",
      "problemMatcher": []
    },
    {
      "label": "Run: ASan",
      "type": "process",
      "command": "${workspaceFolder}/build/asan/warblade.exe",
      "options": { "cwd": "${workspaceFolder}/build/asan" },
      "dependsOn": "Build: ASan",
      "problemMatcher": []
    },
    {
      "label": "Package: Windows installer",
      "type": "process",
      "command": "cmd.exe",
      "args": ["/d", "/c", "build.bat", "release", "package"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": "$msCompile",
      "group": "build"
    },
    {
      "label": "Setup: Build tools",
      "type": "process",
      "command": "powershell.exe",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "setup.ps1"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    }
  ]
}
