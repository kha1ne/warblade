{
  "version": 6,
  "cmakeMinimumRequired": { "major": 4, "minor": 0, "patch": 0 },
  "configurePresets": [
    {
      "name": "windows-base",
      "hidden": true,
      "generator": "Ninja",
      "architecture": { "value": "x64", "strategy": "external" },
      "binaryDir": "${sourceDir}/build/${presetName}",
      "toolchainFile": "${sourceDir}/.tools/vcpkg/scripts/buildsystems/vcpkg.cmake",
      "environment": {
        "VCPKG_ROOT": "${sourceDir}/.tools/vcpkg",
        "VCPKG_DISABLE_METRICS": "1"
      },
      "cacheVariables": {
        "CMAKE_C_COMPILER": "cl",
        "WARBLADE_WARNINGS_AS_ERRORS": false,
        "WARBLADE_ENABLE_ASAN": false,
        "CMAKE_MAKE_PROGRAM": "${sourceDir}/.tools/ninja/ninja.exe",
        "CMAKE_EXPORT_COMPILE_COMMANDS": true,
        "VCPKG_TARGET_TRIPLET": "x64-windows-static",
        "VCPKG_HOST_TRIPLET": "x64-windows-static",
        "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreaded$<$<CONFIG:Debug>:Debug>"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "debug",
      "displayName": "Windows x64 Debug",
      "inherits": "windows-base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "asan",
      "displayName": "Windows x64 Debug + AddressSanitizer",
      "inherits": "debug",
      "cacheVariables": {
        "WARBLADE_ENABLE_ASAN": true,
        "WARBLADE_ENABLE_IPO": false
      }
    },
    {
      "name": "release",
      "displayName": "Windows x64 Release",
      "inherits": "windows-base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    }
  ],
  "buildPresets": [
    { "name": "debug", "configurePreset": "debug" },
    { "name": "asan", "configurePreset": "asan" },
    { "name": "release", "configurePreset": "release" }
  ],
  "packagePresets": [
    {
      "name": "release",
      "displayName": "Warblade Windows installer",
      "configurePreset": "release",
      "generators": ["INNOSETUP"],
      "configurations": ["Release"],
      "packageDirectory": "${sourceDir}/dist"
    }
  ],
  "workflowPresets": [
    {
      "name": "installer",
      "displayName": "Build Release and create the Windows installer",
      "steps": [
        { "type": "configure", "name": "release" },
        { "type": "build", "name": "release" },
        { "type": "package", "name": "release" }
      ]
    }
  ]
}
