* text=auto
*.bat text eol=crlf
*.ps1 text eol=crlf
*.c text eol=lf
*.h text eol=lf
*.json text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.cmake text eol=lf
*.in text eol=lf
*.vsconfig text eol=lf
/assets/** binary
# Preserve upstream patches; blank context lines contain a required leading space.
/vcpkg-ports/**/*.diff text eol=lf whitespace=-blank-at-eol
/vcpkg-ports/**/*.patch text eol=lf whitespace=-blank-at-eol
