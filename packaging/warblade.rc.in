#include <winver.h>

// The first icon resource is also used by shortcuts targeting warblade.exe.
103 ICON "@WARBLADE_ICON_FILE@"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG
#else
 FILEFLAGS 0
#endif
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "kha1ne"
            VALUE "FileDescription", "Warblade"
            VALUE "FileVersion", "@PROJECT_VERSION@"
            VALUE "InternalName", "warblade"
            VALUE "LegalCopyright", "Copyright (c) 2026 kha1ne"
            VALUE "OriginalFilename", "warblade.exe"
            VALUE "ProductName", "Warblade"
            VALUE "ProductVersion", "@PROJECT_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
